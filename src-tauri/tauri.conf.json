{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上班鼓励器",
  "version": "1.4.0",
  "identifier": "com.shangbanguliqi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "上班鼓励器",
        "width": 448,
        "height": 620,
        "minWidth": 400,
        "minHeight": 550,
        "maxWidth": 560,
        "maxHeight": 850,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "signingIdentity": "-" },
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
